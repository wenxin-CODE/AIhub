# StarOps 环境变量示例
# 复制为 .env 并按需修改：cp .env.example .env
#
# 优先级（高 → 低）：
#   1. 进程环境变量（CI / 容器 / shell export）——最权威，不被 .env 覆盖
#   2. 项目根目录 .env 文件
#   3. 代码内默认值
#
# 敏感项（API Key）请只写在 .env，.env 已被 .gitignore 排除。
# 本模板不得包含真实凭据。

# ---- 应用 ----
STAROPS_DEBUG=0
STAROPS_DB_PATH=./data/starops.db
STAROPS_DB_ECHO=0
STAROPS_AUDIT_ENABLED=1

# ---- LLM（不配置则自动降级为离线规则模式，演示仍可跑通）----
# 通用名，切换到任意 OpenAI 兼容端点时用它；优先于 DEEPSEEK_API_KEY
# STAROPS_LLM_API_KEY=sk-your-key-here
# DeepSeek 官方名
DEEPSEEK_API_KEY=sk-your-key-here
DEEPSEEK_BASE_URL=https://api.deepseek.com
DEEPSEEK_MODEL=deepseek-chat
STAROPS_LLM_PROVIDER=deepseek
STAROPS_LLM_TIMEOUT=60
STAROPS_LLM_MAX_RETRIES=2

# ---- Agent ----
STAROPS_CHECKPOINT_DIR=./data/checkpoints
STAROPS_MAX_ITERATIONS=12

# ---- 可复现追踪 ----
STAROPS_TRACE_MODEL_VERSION=v1
STAROPS_TRACE_PROMPT_VERSION=p1
